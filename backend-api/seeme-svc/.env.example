# Copy thành .env rồi điền giá trị thật:  cp .env.example .env && chmod 600 .env
# Dùng cho cả docker compose lẫn chạy local (`dotnet run` tự nạp .env ở thư mục gốc repo).
# KHÔNG commit file .env lên git.

# ---------- SQL Server ----------
# Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
# Gợi ý tạo: echo "Lv$(openssl rand -hex 12)#A1"
# Tránh ký tự ; và ' vì mật khẩu được ghép vào connection string.
MSSQL_SA_PASSWORD=ChangeMe_Strong#Passw0rd
DB_NAME=seeme-web
# RAM tối đa cho SQL Server (MB). Server 4GB RAM nên để 1024.
MSSQL_MEMORY_LIMIT_MB=1024
MSSQL_HOST_PORT=1433

# ---------- Backend ----------
# 0.0.0.0 = mở cổng ra internet; 127.0.0.1 = chỉ cho nginx trên cùng server truy cập
BACKEND_BIND=0.0.0.0
BACKEND_PORT=5274

# ---------- Bí mật ứng dụng (ghi đè appsettings.json theo dạng Section__Key) ----------
# BẮT BUỘC. Tối thiểu 32 ký tự. Tạo bằng: openssl rand -base64 48
JwtSettings__SecretKey=

# Gmail SMTP: dùng App Password (https://myaccount.google.com/apppasswords), KHÔNG dùng mật khẩu Gmail.
EmailSettings__UserName=
EmailSettings__Password=
EmailSettings__FromAddress=
EmailSettings__FromName=Lùng Vài Trà

# Mật khẩu mặc định khi admin tạo user mới (người dùng nên đổi sau khi đăng nhập)
UserSettings__DefaultPassword=

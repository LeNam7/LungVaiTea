# syntax=docker/dockerfile:1# ---------- Base ----------FROM node:20-alpine AS baseRUN apk add --no-cache libc6-compatENV NEXT_TELEMETRY_DISABLED=1# ---------- Dependencies ----------FROM base AS depsWORKDIR /appCOPY package.json yarn.lock .yarnrc.yml ./RUN corepack enable && yarn install --immutable# ---------- Builder ----------FROM base AS builderWORKDIR /appCOPY --from=deps /app/node_modules ./node_modulesCOPY . .# Biến NEXT_PUBLIC_* được nhúng thẳng vào bundle JS lúc build,# nên bắt buộc phải truyền vào ở bước BUILD (không phải lúc chạy container).ARG NEXT_PUBLIC_ENV=productionARG NEXT_PUBLIC_PATHARG NEXT_PUBLIC_API_URLARG NEXT_PUBLIC_STORAGE_URLARG NEXT_PUBLIC_SITE_URLARG NEXT_PUBLIC_SERVER_IPARG NEXT_PUBLIC_COOKIE_DOMAINSARG NEXT_PUBLIC_MAP4D_ACCESS_KEYARG NEXT_PUBLIC_MAP4D_VERSION=2.3ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEYARG NEXT_PUBLIC_CMS_ADMIN_PHONEARG NEXT_PUBLIC_VIDEO_ASSET_BASE_URLARG NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOPARG NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILEARG NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOPARG NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILEARG NEXT_PUBLIC_USD_VND_EXCHANGE_RATE=25400ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEYARG NEXT_PUBLIC_BOOKING_URLENV NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV \    NEXT_PUBLIC_PATH=$NEXT_PUBLIC_PATH \    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \    NEXT_PUBLIC_STORAGE_URL=$NEXT_PUBLIC_STORAGE_URL \    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \    NEXT_PUBLIC_SERVER_IP=$NEXT_PUBLIC_SERVER_IP \    NEXT_PUBLIC_COOKIE_DOMAINS=$NEXT_PUBLIC_COOKIE_DOMAINS \    NEXT_PUBLIC_MAP4D_ACCESS_KEY=$NEXT_PUBLIC_MAP4D_ACCESS_KEY \    NEXT_PUBLIC_MAP4D_VERSION=$NEXT_PUBLIC_MAP4D_VERSION \    NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY \    NEXT_PUBLIC_CMS_ADMIN_PHONE=$NEXT_PUBLIC_CMS_ADMIN_PHONE \    NEXT_PUBLIC_VIDEO_ASSET_BASE_URL=$NEXT_PUBLIC_VIDEO_ASSET_BASE_URL \    NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOP=$NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOP \    NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILE=$NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILE \    NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOP=$NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOP \    NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILE=$NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILE \    NEXT_PUBLIC_USD_VND_EXCHANGE_RATE=$NEXT_PUBLIC_USD_VND_EXCHANGE_RATE \    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \    NEXT_PUBLIC_BOOKING_URL=$NEXT_PUBLIC_BOOKING_URL# Bắt buộc sinh .next/standalone, không phụ thuộc dòng output trong next.config.tsENV NEXT_OUTPUT_STANDALONE=trueRUN corepack enable && yarn build# Fail sớm với thông báo rõ ràng thay vì lỗi COPY khó hiểu ở stage sauRUN test -d .next/standalone || { echo "LOI: khong sinh duoc .next/standalone." >&2; exit 1; }# ---------- Runner ----------FROM base AS runnerWORKDIR /appRUN apk add --no-cache tzdataENV NODE_ENV=production \    PORT=3000 \    HOSTNAME="0.0.0.0"RUN addgroup --system --gid 1001 nodejs \ && adduser --system --uid 1001 nextjsCOPY --from=builder /app/public ./publicCOPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/staticUSER nextjsEXPOSE 3000CMD ["node", "server.js"]
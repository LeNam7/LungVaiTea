# syntax=docker/dockerfile:1

# ---------- Base ----------
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
ENV NEXT_TELEMETRY_DISABLED=1

# ---------- Dependencies ----------
FROM base AS deps
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
RUN corepack enable && yarn install --immutable

# ---------- Builder ----------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Biến NEXT_PUBLIC_* được nhúng thẳng vào bundle JS lúc build,
# nên bắt buộc phải truyền vào ở bước BUILD (không phải lúc chạy container).
ARG NEXT_PUBLIC_ENV=production
ARG NEXT_PUBLIC_PATH
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_STORAGE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SERVER_IP
ARG NEXT_PUBLIC_COOKIE_DOMAINS
ARG NEXT_PUBLIC_MAP4D_ACCESS_KEY
ARG NEXT_PUBLIC_MAP4D_VERSION=2.3
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ARG NEXT_PUBLIC_CMS_ADMIN_PHONE
ARG NEXT_PUBLIC_VIDEO_ASSET_BASE_URL
ARG NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOP
ARG NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILE
ARG NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOP
ARG NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILE
ARG NEXT_PUBLIC_USD_VND_EXCHANGE_RATE=25400
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_BOOKING_URL

ENV NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV \
    NEXT_PUBLIC_PATH=$NEXT_PUBLIC_PATH \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_STORAGE_URL=$NEXT_PUBLIC_STORAGE_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SERVER_IP=$NEXT_PUBLIC_SERVER_IP \
    NEXT_PUBLIC_COOKIE_DOMAINS=$NEXT_PUBLIC_COOKIE_DOMAINS \
    NEXT_PUBLIC_MAP4D_ACCESS_KEY=$NEXT_PUBLIC_MAP4D_ACCESS_KEY \
    NEXT_PUBLIC_MAP4D_VERSION=$NEXT_PUBLIC_MAP4D_VERSION \
    NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY \
    NEXT_PUBLIC_CMS_ADMIN_PHONE=$NEXT_PUBLIC_CMS_ADMIN_PHONE \
    NEXT_PUBLIC_VIDEO_ASSET_BASE_URL=$NEXT_PUBLIC_VIDEO_ASSET_BASE_URL \
    NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOP=$NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOP \
    NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILE=$NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILE \
    NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOP=$NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOP \
    NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILE=$NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILE \
    NEXT_PUBLIC_USD_VND_EXCHANGE_RATE=$NEXT_PUBLIC_USD_VND_EXCHANGE_RATE \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_BOOKING_URL=$NEXT_PUBLIC_BOOKING_URL

# Bắt buộc sinh .next/standalone, không phụ thuộc dòng output trong next.config.ts
ENV NEXT_OUTPUT_STANDALONE=true

RUN corepack enable && yarn build
# Fail sớm với thông báo rõ ràng thay vì lỗi COPY khó hiểu ở stage sau
RUN test -d .next/standalone || { echo "LOI: khong sinh duoc .next/standalone." >&2; exit 1; }

# ---------- Runner ----------
FROM base AS runner
WORKDIR /app
RUN apk add --no-cache tzdata
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]

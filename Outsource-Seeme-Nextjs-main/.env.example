# Môi trường chạy (dev | test | production)
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_PATH=

# URL API Backend và File Storage (ví dụ: https://api.yourdomain.vn)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_SITE_URL=

# Bản đồ Map4D (điền Map4D Access Key để hiển thị bản đồ cây trà)
NEXT_PUBLIC_MAP4D_ACCESS_KEY=
NEXT_PUBLIC_MAP4D_VERSION=2.3

# Bản đồ Google Maps (tùy chọn)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Video asset CDN / Base URL (tùy chọn, mặc định lấy từ /videos)
NEXT_PUBLIC_VIDEO_ASSET_BASE_URL=

# Số điện thoại admin cho phép truy cập trang quản trị CMS (mặc định: 0123456789)
NEXT_PUBLIC_CMS_ADMIN_PHONE=

# SePay Webhook Secret (tùy chọn cho xác thực webhook thanh toán)
SEPAY_WEBHOOK_SECRET=

# Copy file này thành `.env` rồi điền giá trị thật:  cp .env.docker.example .env
# docker compose đọc file `.env` ở thư mục gốc.

# ---- Cổng & binding trên server ----
APP_PORT=3000
# 127.0.0.1 = chỉ cho Nginx trên host truy cập (khuyên dùng khi chạy production có domain)
# 0.0.0.0   = mở ra ngoài Internet qua IP:PORT
APP_BIND=0.0.0.0
IMAGE_TAG=latest
TZ=Asia/Ho_Chi_Minh

# ---- Build-time (nhúng vào JS, đổi phải build lại) ----
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_PATH=
NEXT_PUBLIC_API_URL=https://api.lungvaitra.vn
NEXT_PUBLIC_STORAGE_URL=https://api.lungvaitra.vn
NEXT_PUBLIC_SITE_URL=https://lungvaitra.vn
NEXT_PUBLIC_SERVER_IP=
NEXT_PUBLIC_COOKIE_DOMAINS=

NEXT_PUBLIC_MAP4D_ACCESS_KEY=
NEXT_PUBLIC_MAP4D_VERSION=2.3
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_CMS_ADMIN_PHONE=0123456789

NEXT_PUBLIC_VIDEO_ASSET_BASE_URL=
NEXT_PUBLIC_HOME_BANNER_VIDEO_DESKTOP=
NEXT_PUBLIC_HOME_BANNER_VIDEO_MOBILE=
NEXT_PUBLIC_HOME_BANNER_POSTER_DESKTOP=
NEXT_PUBLIC_HOME_BANNER_POSTER_MOBILE=

# Tỷ giá quy đổi USD/VND
NEXT_PUBLIC_USD_VND_EXCHANGE_RATE=25400
# Stripe - khóa public (an toàn để lộ ra client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Runtime (bí mật phía server, đổi chỉ cần restart) ----
SEPAY_WEBHOOK_SECRET=

# Stripe - KHÓA BÍ MẬT, tuyệt đối không commit
STRIPE_SECRET_KEY=

# PayPal - sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
